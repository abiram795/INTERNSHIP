# API C2C Automation - Environment Configuration

# Application
APP_ENV=development
APP_PORT=8000
APP_HOST=127.0.0.1
SECRET_KEY=super-secret-key-change-in-production-c2c-automator

# Database
# Default is SQLite. For PostgreSQL/Supabase:
# DATABASE_URL=postgresql://user:password@localhost:5432/c2c_automation
DATABASE_URL=sqlite:///./c2c_automation.db

# LinkedIn Integration
# Set to 'false' if you have active authorized LinkedIn Developer App / Partner API credentials
LINKEDIN_USE_MOCK=true
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token

# Gmail API OAuth 2.0
# Set to 'false' when you have configured your Google Cloud credentials
GMAIL_USE_MOCK=true
GMAIL_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_google_client_secret
GMAIL_REFRESH_TOKEN=your_google_refresh_token
GMAIL_SENDER_EMAIL=your_email@gmail.com

# Automation Settings
DEFAULT_SEARCH_FREQUENCY_MINUTES=60
ENABLE_AUTOMATION_ON_STARTUP=false

